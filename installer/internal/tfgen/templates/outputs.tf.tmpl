output "setup" {
  description = "The validated inputs with every derived value resolved: what the wizard would hold in state.Setup after the same answers."
  value = {
    image_source                 = var.image_source
    image_repo                   = local.prebuilt ? var.image_repo : ""
    image_tag                    = local.prebuilt ? var.image_tag : ""
    substrate_revision           = var.substrate_revision
    project_id                   = var.project_id
    cluster_location             = var.cluster_location
    region                       = local.region
    bucket_name                  = local.bucket_name
    machine_type                 = var.machine_type
    network                      = var.network
    subnetwork                   = var.subnetwork
    cluster_version              = local.cluster_version
    release_channel              = local.release_channel
    build_repository             = local.prebuilt ? "" : local.build_repository
    creates_artifact_repository  = local.creates_artifact_repository
    artifact_registry_repository = local.repository_name
    create_cluster               = var.create_cluster
    cluster_name                 = var.cluster_name
    install_filestore_csi        = var.install_filestore_csi
    autoscaling_enabled          = var.autoscaling_enabled
    node_pool                    = var.node_pool
    autoscaling_min_nodes        = var.autoscaling_min_nodes
    autoscaling_max_nodes        = var.autoscaling_max_nodes
    sandbox_class                = var.sandbox_class
    deploy_demo                  = var.deploy_demo
  }
}

output "cluster_name" {
  description = "The GKE cluster Substrate runs on."
  value       = var.cluster_name
  depends_on  = [helm_release.substrate, terraform_data.control_plane_source]
}

output "get_credentials" {
  description = "The command that points kubectl at the cluster."
  value       = "gcloud container clusters get-credentials ${var.cluster_name} --location ${var.cluster_location} --project ${var.project_id}"
}

output "snapshot_bucket" {
  description = "The GCS bucket holding actor snapshots and the micro-VM assets."
  value       = google_storage_bucket.snapshots.name
}

output "cluster_endpoint" {
  description = "The cluster's API server address, for configuring the helm provider."
  value       = local.cluster_endpoint
}

output "cluster_ca_certificate" {
  description = "The cluster's CA certificate (base64 PEM), for configuring the helm provider."
  value       = local.cluster_ca_certificate
}
