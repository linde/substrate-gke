terraform {
  # 1.9 is the first release whose variable validation may read other
  # variables, which the generated rules do (image_source, autoscaling_enabled).
  required_version = ">= 1.9"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = ">= 6.0"
    }
    # Configured by the caller, against the cluster this module outputs
    # (cluster_endpoint, cluster_ca_certificate); see terraform/example.
    helm = {
      source  = "hashicorp/helm"
      version = ">= 3.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = ">= 4.0"
    }
  }
}
