# Code generated by installer/cmd/tfgen from installer/internal/inputs; DO NOT EDIT.
# Edit the declarations in installer/internal/inputs and run `make generate`;
# see terraform/modules/substrate-gke/README.md for how the module is generated and kept in sync.

# The Substrate install, after the GCP resources: the wizard's steps 6 to 10.
#
# The control plane is two Helm charts generated from the Substrate project's
# own manifests (charts/, rendered by installer/internal/chartgen): the CRDs,
# then everything `ate-setup deploy ate-system` applies. What a chart cannot
# own is done here or by scripts/substrate.sh:
#
#   - the key pools ate-setup generates, from Terraform's tls provider (so the
#     private keys are in Terraform state; the CAs last 365 days, as
#     ate-setup's do);
#   - the ate.dev/substrate-version node label, on the node pool;
#   - a build from source, which pushes images and so still runs ate-setup;
#   - the Filestore driver, the micro-VM sandbox and the demo, which are not
#     Kubernetes objects a chart can own (a git clone and deploy script, assets
#     staged into the bucket, ActorTemplates created through ate-api-server).
#
# A script step re-runs when what it was run with changes (triggers_replace),
# not when the cluster drifts; `terraform apply -replace=...` forces one.

locals {
  install_script = "${path.module}/scripts/substrate.sh"
  charts         = "${path.module}/charts"
  work_dir       = var.substrate_work_dir != "" ? var.substrate_work_dir : abspath("${path.root}/.substrate")

  # The version the nodes are labelled with and the atelet DaemonSet selects:
  # for pre-built images, the tag without any @digest (ate-setup's rule).
  substrate_version = split("@", var.image_tag)[0]

  # ate-setup's JWT issuer for a GKE cluster (steps/create.go).
  jwt_issuer = "https://container.googleapis.com/v1/projects/${var.project_id}/locations/${var.cluster_location}/clusters/${var.cluster_name}"

  # The environment the wizard gives its steps (snapshot.Builder.env and
  # microVMEnv), plus what the script itself reads.
  install_env = {
    PROJECT_ID                   = var.project_id
    PROJECT_NUMBER               = local.project_number
    GCE_REGION                   = local.region
    CLUSTER_NAME                 = var.cluster_name
    CLUSTER_LOCATION             = var.cluster_location
    CLUSTER_VERSION              = local.cluster_version
    RELEASE_CHANNEL              = local.release_channel
    NETWORK                      = var.network
    SUBNETWORK                   = var.subnetwork
    NODE_MACHINE_TYPE            = var.machine_type
    BUCKET_NAME                  = google_storage_bucket.snapshots.name
    ARTIFACT_REGISTRY_REPOSITORY = local.repository_name
    CREATE_ARTIFACT_REPOSITORY   = "false"
    KO_DOCKER_REPO               = local.build_repository
    KO_DEFAULTPLATFORMS          = "linux/amd64"
    ARCH                         = "amd64"
    ATE_INSTALL_KIND             = "false"
    KUBECTL_CONTEXT              = ""
    NO_DEV_ENV                   = "1"
    ATE_CREDENTIAL_PROVIDER      = jsonencode({ name = "k8s.io" })
    SUBSTRATE_REPO               = local.substrate_repo
    SUBSTRATE_REVISION           = var.substrate_revision
    SUBSTRATE_WORK_DIR           = local.work_dir
    SUBSTRATE_VERSION            = local.substrate_version
    IMAGE_SOURCE                 = var.image_source
    IMAGE_REPO                   = var.image_repo
    IMAGE_TAG                    = var.image_tag
    SANDBOX_CLASS                = var.sandbox_class
  }
}

# ─── Key pools ─────────────────────────────────────────────────────────────

locals {
  # chartgen.KeyPools: the CA pools and their key types.
  ca_pools = {
    "actorIdCA"     = "ED25519"
    "egressMitmCA"  = "ECDSA"
    "podIdentityCA" = "ED25519"
    "serviceDnsCA"  = "ED25519"
  }
  # A PEM block's base64 body is its DER, base64-encoded: what the pool JSON
  # holds (Go marshals []byte as standard base64).
  pem_der_b64 = "/-----[A-Z ]+-----|\\s/"
}

resource "tls_private_key" "ca" {
  for_each = var.install_substrate ? local.ca_pools : {}

  algorithm   = each.value
  ecdsa_curve = each.value == "ECDSA" ? "P256" : null
}

resource "tls_self_signed_cert" "ca" {
  for_each = tls_private_key.ca

  private_key_pem = each.value.private_key_pem
  subject {
    common_name = "substrate ${each.key}"
  }
  is_ca_certificate     = true
  validity_period_hours = 8760
  allowed_uses          = ["cert_signing", "digital_signature"]
}

# The actor-identity JWT signing key (ES256).
resource "tls_private_key" "jwt" {
  count = var.install_substrate ? 1 : 0

  algorithm   = "ECDSA"
  ecdsa_curve = "P256"
}

locals {
  jwt_key_id = var.install_substrate ? substr(sha256(tls_private_key.jwt[0].public_key_pem), 0, 16) : ""

  # The pool formats internal/localca and internal/localjwtauthority read.
  key_pools = merge(
    {
      for k, cert in tls_self_signed_cert.ca : k => {
        pool = jsonencode({
          CAs = [{
            ID                 = "1"
            SigningKeyPKCS8    = replace(tls_private_key.ca[k].private_key_pem_pkcs8, local.pem_der_b64, "")
            RootCertificateDER = replace(cert.cert_pem, local.pem_der_b64, "")
          }]
          ActiveForSigning = "1"
        })
        cert = cert.cert_pem
        key  = tls_private_key.ca[k].private_key_pem_pkcs8
      }
    },
    var.install_substrate ? {
      actorIdJwt = {
        pool = jsonencode({
          Authorities = [{
            ID              = local.jwt_key_id
            Algorithm       = "ES256"
            SigningKeyPKCS8 = replace(tls_private_key.jwt[0].private_key_pem_pkcs8, local.pem_der_b64, "")
          }]
          ActiveForSigning = local.jwt_key_id
        })
      }
    } : {},
  )
}

# ─── Step 6: Turn on Substrate ─────────────────────────────────────────────

# An existing cluster's nodes get the version label here; a pool this module
# creates carries it already.
resource "terraform_data" "label_nodes" {
  count = var.install_substrate && local.prebuilt && !var.create_cluster ? 1 : 0

  triggers_replace = { cluster = local.cluster_id, version = local.substrate_version }

  provisioner "local-exec" {
    command     = "${local.install_script} label-nodes"
    interpreter = ["bash", "-c"]
    environment = local.install_env
  }
}

resource "helm_release" "crds" {
  count = var.install_substrate ? 1 : 0

  name             = "substrate-crds"
  chart            = "${local.charts}/substrate-crds"
  namespace        = "ate-system"
  create_namespace = true
  # Adopt objects an earlier ate-setup (wizard) install created.
  take_ownership = true

  depends_on = [google_container_node_pool.substrate, data.google_container_cluster.existing]
}

resource "helm_release" "substrate" {
  count = var.install_substrate && local.prebuilt ? 1 : 0

  name      = "substrate"
  chart     = "${local.charts}/substrate"
  namespace = "ate-system"
  wait      = true
  timeout   = 900
  # Adopt objects an earlier ate-setup (wizard) install created. Its key
  # pools are then replaced by these, which rotates the CAs.
  take_ownership = true

  values = [sensitive(yamlencode({
    substrateVersion = local.substrate_version
    images = {
      "ateapi"             = "${var.image_repo}/ateapi:${local.substrate_version}"
      "atecontroller"      = "${var.image_repo}/atecontroller:${local.substrate_version}"
      "atelet"             = "${var.image_repo}/atelet:${local.substrate_version}"
      "atenet"             = "${var.image_repo}/atenet:${local.substrate_version}"
      "envoy-dataplane"    = "${var.image_repo}/envoy-dataplane:${local.substrate_version}"
      "kubernetes-secrets" = "${var.image_repo}/kubernetes-secrets:${local.substrate_version}"
      "podcertcontroller"  = "${var.image_repo}/podcertcontroller:${local.substrate_version}"
    }
    jwtIssuer = local.jwt_issuer
    keyPools  = local.key_pools
  }))]

  depends_on = [
    helm_release.crds,
    terraform_data.label_nodes,
    google_project_iam_member.node,
    google_project_iam_member.atelet,
    google_storage_bucket_iam_member.snapshots,
  ]
}

# A build from source pushes images first, so it still runs ate-setup.
resource "terraform_data" "control_plane_source" {
  count = var.install_substrate && !local.prebuilt ? 1 : 0

  triggers_replace = {
    cluster  = local.cluster_id
    revision = var.substrate_revision
    registry = local.build_repository
  }

  provisioner "local-exec" {
    command     = "${local.install_script} control-plane"
    interpreter = ["bash", "-c"]
    environment = local.install_env
  }

  depends_on = [
    helm_release.crds,
    google_artifact_registry_repository.images,
    google_project_iam_member.node,
    google_project_iam_member.atelet,
    google_storage_bucket_iam_member.snapshots,
  ]
}

locals {
  # Set once the control plane is up, by whichever path installed it.
  control_plane_id = var.install_substrate ? (local.prebuilt ? helm_release.substrate[0].id : terraform_data.control_plane_source[0].id) : ""
}

# ─── Step 7: Install Filestore CSI driver ──────────────────────────────────

resource "terraform_data" "filestore_csi" {
  count = var.install_substrate && var.install_filestore_csi ? 1 : 0

  triggers_replace = local.cluster_id

  provisioner "local-exec" {
    command     = "${local.install_script} filestore"
    interpreter = ["bash", "-c"]
    environment = local.install_env
  }

  depends_on = [helm_release.substrate, terraform_data.control_plane_source]
}

# ─── Step 8: Configure autoscaling ─────────────────────────────────────────

# Only an existing cluster needs this; the pool this module creates has its
# bounds already.
resource "terraform_data" "autoscaling" {
  count = !var.create_cluster && var.autoscaling_enabled ? 1 : 0

  triggers_replace = {
    cluster = local.cluster_id
    pool    = var.node_pool
    min     = var.autoscaling_min_nodes
    max     = var.autoscaling_max_nodes
  }

  provisioner "local-exec" {
    command     = "${local.install_script} autoscaling"
    interpreter = ["bash", "-c"]
    environment = merge(local.install_env, {
      NODE_POOL = var.node_pool
      MIN_NODES = tostring(var.autoscaling_min_nodes)
      MAX_NODES = tostring(var.autoscaling_max_nodes)
    })
  }
}

# ─── Step 9: Choose your sandbox runtime ───────────────────────────────────

# gVisor came with the control plane. Micro-VM assembles and stages its
# assets into the bucket and applies its SandboxConfig, which carries their
# checksums (hack/install-microvm-deps.sh).
resource "terraform_data" "microvm" {
  count = var.install_substrate && var.sandbox_class == "microvm" ? 1 : 0

  triggers_replace = {
    control_plane = local.control_plane_id
    bucket        = google_storage_bucket.snapshots.name
  }

  provisioner "local-exec" {
    command     = "${local.install_script} microvm"
    interpreter = ["bash", "-c"]
    environment = local.install_env
  }

  depends_on = [terraform_data.filestore_csi, terraform_data.autoscaling]
}

# ─── Step 10: Deploy a demo workload ───────────────────────────────────────

# counter, or counter-microvm. Its ActorTemplate is created through
# ate-api-server, so this runs ate-setup.
resource "terraform_data" "demo" {
  count = var.install_substrate && var.deploy_demo ? 1 : 0

  triggers_replace = {
    control_plane = local.control_plane_id
    sandbox_class = var.sandbox_class
  }

  provisioner "local-exec" {
    command     = "${local.install_script} demo"
    interpreter = ["bash", "-c"]
    environment = local.install_env
  }

  depends_on = [terraform_data.microvm, terraform_data.filestore_csi]
}
